# Contact form (Formspree + reCAPTCHA v3)
# Copy to .env and fill in. For GitHub Pages, set these as repository variables.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key
NEXT_PUBLIC_FORMSPREE_FORM_ID=your_formspree_form_id

# Optional: Google Analytics 4
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: CSV feeds (playlists, recordings, this week's tracks)
# NEXT_PUBLIC_PLAYLISTS_CSV_URL=
# NEXT_PUBLIC_RECORDINGS_CSV_URL=
# This week's tracks - use the export URL from your Google Sheet (run update-playlist-from-sheet.sh to update)
# Example: https://docs.google.com/spreadsheets/d/1IO8H4JYfvW_cw0cDV2tSV2VH57XCo9kPh9dmN6fV_kE/export?format=csv&gid=517217887
# NEXT_PUBLIC_TRACKS_CSV_URL=
